# ---- core ----
APP_ENV=dev
DATABASE_URL=sqlite:///./data/plnews.db
# DATABASE_URL=postgresql+psycopg://plnews:plnews@localhost:5432/plnews
TIMEZONE=Europe/Sofia
DIGEST_HOUR=7                      # local hour the daily digest is built

# ---- LLM ----
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL_ANALYSIS=claude-sonnet-5          # per-story analysis (high volume)
LLM_MODEL_DEEPDIVE=claude-opus-5            # single daily deep dive (high quality)
LLM_MAX_CONCURRENCY=4
LLM_DAILY_TOKEN_BUDGET=2000000

# ---- delivery ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=123456789          # comma separated
OBSIDIAN_VAULT_PATH=./data/obsidian
API_KEY=change-me                            # simple bearer for write endpoints

# ---- ingestion ----
INGEST_LOOKBACK_HOURS=30
MAX_ARTICLES_PER_SOURCE=40
HTTP_USER_AGENT=PlNewsBot/0.1 (+https://example.org/plnews)
